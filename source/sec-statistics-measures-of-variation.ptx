                <cell>9</cell>
                <cell>3</cell>
            </row>
            <row>
                <cell>10</cell>
                <cell>3</cell>
            </row>
            <row>
                <cell>11</cell>
                <cell>2</cell>
            </row>
            <row>
                <cell>12</cell>
