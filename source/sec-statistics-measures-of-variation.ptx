        </p>
        <tabular halign="center" top="minor" left="minor" right="minor" bottom="minor">
            <row>
                <cell>53,000</cell>
                <cell>70,000</cell>
                <cell>12,800</cell>
                <cell>30,000</cell>
                <cell>4,500</cell>
                <cell>42,000</cell>
                <cell>48,000</cell>
                <cell>60,000</cell>
                <cell>108,000</cell>
                <cell>11,000</cell>
            </row>
        </tabular>
        <p>
        <ol marker="a.">
            <li>
                <p>
                    Find the standard deviation of each group.
                </p>
            </li>
            <li>
                <p>
                    Calculate the 5-number summary for each group.
                </p>
            </li>
            <li>
                <p>
                    Calculate the range and IQR for each group.
                </p>
            </li>
            <li>
                <p>
                    Create side-by-side boxplots, and compare and contrast the two groups.
                </p>
            </li>
        </ol>
        </p>
        </statement>
        <solution>
            <p>
            <ol marker="a.">
                <li>
                    <p>
